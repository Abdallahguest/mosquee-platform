# ─────────────────────────────────────────────────────────────────────────────
# Amana Connect — variables d'environnement
#
# Copier ce fichier :  cp .env.example .env.local
# Remplir les valeurs, ne jamais commiter .env.local (secrets).
# ─────────────────────────────────────────────────────────────────────────────

# ── Obligatoires (démarrage local + auth) ──

# PostgreSQL Neon — connection string complète
# Ex: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Secret de signature des sessions Better-Auth (min. 32 caractères aléatoires)
# Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL publique de l'app (auth, redirections, métadonnées)
# Local : http://localhost:3000  |  Prod : https://amanaconnect.org
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── E-mail (Resend) — optionnel en local, requis pour reset mot de passe ──

RESEND_API_KEY=
# Adresse expéditeur (domaine vérifié dans Resend)
EMAIL_FROM=noreply@mail.amanaconnect.org
EMAIL_FROM_NAME=Amana Connect

# ── Audio (Cloudflare R2) — requis pour l'upload audio admin ──
# Sans ces variables : le reste de l'app fonctionne, mais pas l'audio.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL publique du bucket (ex: https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=

# ── Observabilité (Sentry) — optionnel ──

NEXT_PUBLIC_SENTRY_DSN=
# Uniquement pour l'upload des source maps au build (CI / Vercel)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
